# Settings for deploy/docker-compose.yml (copy to .env next to it).
# Public address of the planner (DNS record pointing to your server)
DOMAIN=planer.example.ch
# Certificate resolver of your Traefik
TRAEFIK_CERTRESOLVER=letsencrypt
# Optional password gate in front of the app (HTTP Basic Auth); the QR check-in stays public
GATE_USER=zivilschutz
GATE_PASSWORD=
POSTGRES_PASSWORD=
# Code for the first-time setup in the browser (recommended while the installation is empty and reachable)
SETUP_TOKEN=
